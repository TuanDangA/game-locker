{% comment %}
  Replaces the .gl-drawer-summary block (and the separate sliding
  .gl-panel-shipping panel) in your existing cart-drawer-custom snippet.

  This version matches the reference design exactly:
  - Red subtotal box with a single full-width black "Checkout" button
    (no separate "View cart" button, per the design)
  - "Estimate shipping" is now an INLINE ACCORDION that expands directly
    below the summary box (chevron flips up/down), instead of sliding in
    as a separate panel.

  Drop this in place of your current .gl-drawer-summary +
  .gl-panel-shipping markup, and replace the old shipping-panel JS block
  with the JS at the bottom of this file (it reuses your existing
  working /cart/shipping_rates.json logic, just restructured for the
  accordion instead of panel-slide).
{% endcomment %}

<style>
  /* --- Subtotal + Checkout --- */
  .gl-summary-box {
    background: {{ gl_subtotal_bg_color | default: '#a10a0a' }};
    color: #fff;
    border-radius: 8px 8px 0 0;
    padding: 1.1rem 1.25rem;
  }
  .gl-summary-box__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 400;
    font-size: 20px;
    text-transform: uppercase;
    font-family: 'Oswald';
    margin-bottom: 0.85rem;
  }
  .gl-summary-box__checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 46px;
    background: #111;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-family: 'Oswald';
    cursor: pointer;
  }
  .gl-summary-box__checkout:hover { background: #000; }

  /* --- Estimate shipping accordion --- */
  .gl-shipping-accordion {
    border: 1px solid #e5e5e5;
    border-top: none;
    border-radius: 0 0 8px 8px;
    background: #fff;
    overflow: hidden;
  }

  .gl-shipping-accordion__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1rem 1.25rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 20px;
    font-weight: 400;
    color: #1D1A17;
    font-family: 'Oswald';
  }
  .gl-shipping-accordion__toggle svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  .gl-shipping-accordion.is-open .gl-shipping-accordion__toggle svg {
    transform: rotate(180deg);
  }

  .gl-shipping-accordion__body {
    display: none;
    padding: 0 1.25rem 1.25rem;
  }
  .gl-shipping-accordion.is-open .gl-shipping-accordion__body {
    display: block;
  }

  .gl-shipping-field { margin-bottom: 1rem; }
  .gl-shipping-field label {
    display: block;
    font-size: 13px;
    font-weight: 400;
    margin-bottom: 0.4rem;
    color: #1D1A17;
  }
  .gl-shipping-field select,
  .gl-shipping-field input {
    width: 100%;
    height: 44px;
    padding: 0 0.85rem;
    border: 1px solid #d8d8d8;
    border-radius: 4px;
    font-size: 14px;
    box-sizing: border-box;
    background: #fff;
    color: #1D1A17;
  }

  .gl-shipping-estimate-btn {
    width: 100%;
    height: 46px;
    background: #fff;
    color: #1D1A17;
    border: 1px solid #1D1A17;
    border-radius: 4px;
    font-weight: 700;
    font-size: 13px;
    font-family: 'Oswald';
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .gl-shipping-estimate-btn:hover { background: #f5f5f5; }
  .gl-shipping-estimate-btn.is-loading { opacity: 0.6; pointer-events: none; }

  .gl-shipping-results {
    display: none;
    margin-top: 1rem;
    padding: 0.9rem;
    border: 1px solid #C0DFF6;
    border-radius: 4px;
    background: #F4FAFF;
    font-size: 13px;
  }
  .gl-shipping-results.is-visible { display: block; }
  .gl-shipping-results ul { margin: 0.4rem 0 0; padding-left: 1.1rem; }
  .gl-shipping-results li { margin-bottom: 0.3rem; color: #1D1A17; }
  .gl-shipping-results p { color: {{ gl_price_color | default: '#1D1A17' }}; }
</style>

{%- if cart.item_count > 0 -%}
  <div class="gl-drawer-summary">
    <div class="gl-summary-box">
      <div class="gl-summary-box__row">
        <span>Subtotal</span>
        <span data-gl-subtotal>{{ cart.total_price | money }}</span>
      </div>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="gl-summary-box__checkout">Checkout</button>
      </form>
    </div>

    <div class="gl-shipping-accordion" data-gl-shipping-accordion>
      <button type="button" class="gl-shipping-accordion__toggle" data-gl-shipping-toggle>
        <span>Estimate shipping</span>
        <svg viewBox="0 0 12 8" fill="none"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="2"/></svg>
      </button>

      <div class="gl-shipping-accordion__body">
        <div class="gl-shipping-field">
          <label for="gl-shipping-country-drawer">Country</label>
          <select id="gl-shipping-country-drawer" data-gl-shipping-country>
            {{ all_country_option_tags }}
          </select>
        </div>

        <div class="gl-shipping-field">
          <label for="gl-shipping-province-drawer">State</label>
          <select id="gl-shipping-province-drawer" data-gl-shipping-province></select>
        </div>

        <div class="gl-shipping-field">
          <label for="gl-shipping-zip-drawer">Zip code</label>
          <input type="text" id="gl-shipping-zip-drawer" data-gl-shipping-zip placeholder="e.g. 2000">
        </div>

        <button type="button" class="gl-shipping-estimate-btn" data-gl-estimate-shipping>Estimate shipping</button>

        <div class="gl-shipping-results" data-gl-shipping-results></div>
      </div>
    </div>
  </div>
{%- endif -%}

<script>
(function () {
  var accordion = document.querySelector('[data-gl-shipping-accordion]');
  if (!accordion) return;

  var toggleBtn = accordion.querySelector('[data-gl-shipping-toggle]');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', function () {
      accordion.classList.toggle('is-open');
    });
  }

  function formatMoney(cents) {
    if (window.Shopify && Shopify.formatMoney) {
      return Shopify.formatMoney(cents, '{{ shop.money_format }}');
    }
    return '{{ shop.currency }} ' + (cents / 100).toFixed(2);
  }

  var countrySelect = accordion.querySelector('[data-gl-shipping-country]');
  var provinceSelect = accordion.querySelector('[data-gl-shipping-province]');
  var zipInput = accordion.querySelector('[data-gl-shipping-zip]');
  var estimateBtn = accordion.querySelector('[data-gl-estimate-shipping]');
  var resultsBox = accordion.querySelector('[data-gl-shipping-results]');

  function populateProvinces() {
    if (!countrySelect || !provinceSelect) return;
    var selectedOption = countrySelect.options[countrySelect.selectedIndex];
    var provincesData = selectedOption ? selectedOption.getAttribute('data-provinces') : null;
    provinceSelect.innerHTML = '';
    if (!provincesData) return;
    try {
      var provinces = JSON.parse(provincesData);
      if (!provinces.length) {
        provinceSelect.innerHTML = '<option value="">N/A</option>';
        return;
      }
      provinces.forEach(function (p) {
        var opt = document.createElement('option');
        opt.value = p[0];
        opt.textContent = p[1];
        provinceSelect.appendChild(opt);
      });
    } catch (e) {
      console.error('Could not parse provinces:', e);
    }
  }

  if (countrySelect) {
    countrySelect.addEventListener('change', populateProvinces);
    populateProvinces();
  }

  if (estimateBtn) {
    estimateBtn.addEventListener('click', function () {
      var country = countrySelect ? countrySelect.value : '';
      var province = provinceSelect ? provinceSelect.value : '';
      var zip = zipInput ? zipInput.value.trim() : '';

      if (!zip) {
        resultsBox.innerHTML = '<p>Please enter a zip/postal code.</p>';
        resultsBox.classList.add('is-visible');
        return;
      }

      estimateBtn.classList.add('is-loading');
      resultsBox.classList.remove('is-visible');

      var params = new URLSearchParams({
        'shipping_address[zip]': zip,
        'shipping_address[country]': country,
        'shipping_address[province]': province
      });

      fetch('/cart/shipping_rates.json?' + params.toString())
        .then(function (res) { return res.json(); })
        .then(function (data) {
          var rates = data.shipping_rates || [];
          if (!rates.length) {
            resultsBox.innerHTML = '<strong>No shipping rates available for this address.</strong>';
          } else {
            var html = '<strong>There are multiple shipping rates for your address:</strong><ul>';
            rates.forEach(function (rate) {
              html += '<li>' + rate.name +  'shipping:' + ': <strong>' + formatMoney(Math.round(parseFloat(rate.price) * 100)) + '</strong></li>';
            });
            html += '</ul>';
            resultsBox.innerHTML = html;
          }
          resultsBox.classList.add('is-visible');
        })
        .catch(function (err) {
          console.error('Shipping estimate failed:', err);
          resultsBox.innerHTML = '<strong>Could not estimate shipping. Please try again.</strong>';
          resultsBox.classList.add('is-visible');
        })
        .finally(function () {
          estimateBtn.classList.remove('is-loading');
        });
    });
  }
})();
</script>
