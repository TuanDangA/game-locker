{%- doc -%}
  @param [limit] - {number}

  The maximum number of items to display. Anything above shows as "99+".
{%- enddoc -%}

<span
  ref="cartBubble"
  class="cart-bubble{% if cart.item_count == 0 %} visually-hidden{% endif %}"
>
  (<span
    ref="cartBubbleCount"
    id="cart-bubble-text"
    aria-hidden="true"
    data-testid="cart-bubble"
  >{%- if limit != blank and cart.item_count > limit -%}
      {{- limit -}}+
    {%- else -%}
      {{- cart.item_count -}}
    {%- endif -%}</span>)
</span>

{% stylesheet %}
  .cart-bubble {
    font: inherit;
    color: inherit;
    margin-inline-start: 0.25em;
  }
{% endstylesheet %}