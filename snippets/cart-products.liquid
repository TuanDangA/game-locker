{% doc %}
  Cart Products

  Renders the cart products list or empty cart state.

  @param {boolean} [force_empty] - Force render empty cart state
  @param {block} [block] - The block object providing settings and editor attributes.
  @param {string} [context] - Render context — pass 'drawer' when rendered inside the cart drawer.

  @example
  {% render 'cart-products', force_empty: true %}
{% enddoc %}

{% render 'cart-typography-styles' %}
{% render 'price-styles' %}

{% liquid
  assign block_settings = block.settings
%}

{%- if block_settings.input_style == 'custom' -%}
  {%- capture custom_style -%}
    {%- render 'input-custom-styles', block_settings: block_settings -%}
    --style-border-width-inputs: {{ block_settings.border_width }}px;
    --style-border-radius-inputs: {{ block_settings.border_radius }}px;
    --style-border-radius-buttons-primary: {{ block_settings.border_radius }}px;
    --style-border-radius-buttons-secondary: {{ block_settings.border_radius }}px;
  {%- endcapture -%}
{%- endif -%}

<script
  src="{{ 'component-cart-items.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<script
  src="{{ 'component-cart-quantity-selector.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<script
  src="{{ 'volume-pricing-info.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'text-component-shimmer-styles' %}

<div
  {{ block.shopify_attributes }}
  class="cart-items__wrapper{% if context == 'drawer' and cart.empty? or force_empty %} cart-items__wrapper--drawer-empty{% endif %}"
  {% if context == 'drawer' and cart.empty? or force_empty %}
    data-cart-drawer-empty
  {% endif %}
  style="
    {%- if settings.product_title_case == 'uppercase' -%}
      --product-title-case: uppercase;
    {%- endif -%}
    {{- custom_style -}}
  "
>
  {% if cart.empty? or force_empty %}
    {%- if shop.customer_accounts_enabled and customer == null -%}
      <p>
        {{ 'actions.log_in_html' | t: link: routes.account_login_url }}
      </p>
    {%- endif -%}

    <a
      class="button cart-items__empty-button"
      href="{{ settings.empty_cart_button_link | default: routes.all_products_collection_url }}"
    >
      <span class="button-text">
        {{ 'actions.continue_shopping' | t }}
      </span>
    </a>

  {%- else -%}
    <span
      class="visually-hidden"
      ref="cartItemCount"
      aria-hidden="true"
    >
      {{- cart.item_count -}}
    </span>

    <form
      action="{{ routes.cart_url }}"
      class="cart-form"
      id="cart-form"
      method="post"
    >
      <div
        class="cart-items spacing-style{% if block_settings.dividers %} cart-items--dividers{% endif %}"
        style="{% render 'spacing-style', settings: block_settings %} --cart-items-gap:{{ block_settings.gap | append: 'px' }};"
      >
        <table
          class="cart-items__table"
          role="table"
        >
          <caption
            class="visually-hidden"
            role="caption"
          >
            {{ 'content.cart_total' | t }}
            <span>{{ cart.total_price | money_with_currency }}</span>
          </caption>

          <!--
            =========================
                 TABLE HEAD
            ==========================
          -->

          <thead
            class="cart-items__table-head"
            role="rowgroup"
          >
            <tr
              role="row"
              class="cart-items__table-header-row"
            >
              <!-- COLUMN 1: DELETE -->
              <th
                scope="col"
                role="columnheader"
                class="cart-items__header cart-items__header--delete"
              >
                <span class="visually-hidden">
                  {{ 'accessibility.remove' | t }}
                </span>
              </th>

              <!-- COLUMN 2: IMAGE -->
              <th
                scope="col"
                role="columnheader"
                class="cart-items__header cart-items__header--image"
              >
                <span class="visually-hidden">
                  {{ 'content.product_image' | t }}
                </span>
              </th>

              <!-- COLUMN 3: INFORMATION -->
              <th
                scope="col"
                role="columnheader"
                class="cart-items__header cart-items__header--information"
              >
                <span> Product </span>
              </th>

              <!-- COLUMN 4: PRICE + QUANTITY -->
              <th
                scope="col"
                role="columnheader"
                class="cart-items__header cart-items__header--quantity"
              >
                <span> Price / Quantity </span>
              </th>

              <!-- COLUMN 5: TOTAL -->
              <th
                scope="col"
                role="columnheader"
                class="cart-items__header cart-items__header--total"
              >
                <span> Total </span>
              </th>
            </tr>
          </thead>

          <!--
            =========================
                 CART PRODUCTS
            ==========================
          -->

          <tbody role="rowgroup">
            {% for item in cart.items %}
              <tr
                id="CartItem-{{ item.key }}"
                role="row"
                class="
                  cart-items__table-row
                  {% if item.parent_relationship.parent != null %}
                    cart-items__nested-line
                  {% endif %}
                  {% if context == 'drawer' %}
                    {% unless item.unit_price_measurement %}
                      cart-items__table-row--full-width-variants
                    {% endunless %}
                  {% endif %}
                "
                ref="cartItemRows[]"
                data-parent-key="{{ item.parent_relationship.parent.key }}"
                data-key="{{ item.key }}"
              >
                <!--
                  ==================================
                       COLUMN 1: DELETE / BIN
                  ===================================
                -->

                <td
                  class="cart-items__remove-column"
                  role="cell"
                >
                  {% assign can_remove = item.instructions.can_remove | default: true, allow_false: true %}

                  <button
                    class="button cart-items__remove"
                    type="button"
                    aria-label="{{ 'accessibility.remove_item' | t: title: item.title | escape }}"
                    on:click="/onLineItemRemove/{{ item.index | plus: 1 }}"
                    {% if can_remove == false %}
                      hidden
                    {% endif %}
                  >
                    {{- 'icon-delete.svg' | inline_asset_content -}}

                    <span class="visually-hidden">
                      {{ 'accessibility.remove' | t }}
                    </span>
                  </button>
                </td>

                <!--
                  ==================================
                       COLUMN 2: PRODUCT IMAGE
                  ===================================
                -->

                <td
                  class="cart-items__media"
                  role="cell"
                >
                  {% if item.image %}
                    {% liquid
                      assign ratio = 1

                      assign border_opacity = settings.cart_thumbnail_border_opacity | divided_by: 100.0

                      assign border_override = '--border-width: [cart_thumbnail_border_width]px; --border-style: [cart_thumbnail_border_style]; --border-color: rgb(var(--color-border-rgb) / [cart_thumbnail_border_opacity]); --border-radius: [cart_thumbnail_border_radius]px;' | replace: '[cart_thumbnail_border_width]', settings.cart_thumbnail_border_width | replace: '[cart_thumbnail_border_style]', settings.cart_thumbnail_border | replace: '[cart_thumbnail_border_opacity]', border_opacity | replace: '[cart_thumbnail_border_radius]', settings.cart_thumbnail_border_radius

                      if settings.cart_thumbnail_border_radius > 0
                        assign border_override = border_override | append: ' overflow: hidden;'
                      endif

                      if block_settings.image_ratio == 'portrait'
                        assign ratio = 0.8
                      elsif block_settings.image_ratio == 'adapt'
                        assign ratio = item.image.aspect_ratio
                      endif
                    %}

                    <a
                      href="{{ item.url }}"
                      class="cart-items__media-container"
                      style="--ratio:{{ ratio }};"
                    >
                      {%- liquid
                        echo item.image | image_url: width: 250 | image_tag: class: 'cart-items__media-image border-style', style: border_override
                      -%}
                    </a>
                  {% endif %}
                </td>

                <!--
                  ==================================
                       COLUMN 3:
                       TITLE
                       VARIANT
                       METAFIELD DESCRIPTION
                       PRICE
                  ===================================
                -->

                <td
                  class="cart-items__details cart-primary-typography"
                  role="cell"
                >
                  <div class="cart-items__product-info">
                    <!-- Product title -->

                    <div class="cart-items__heading">
                    <div class="cart-items__title-row">
                      <a
                        href="{{ item.url }}"
                        class="cart-items__title"
                        {% if item.parent_relationship.parent != null %}
                          aria-label="{{ 'accessibility.nested_product' | t: product_title: item.product.title, parent_title: item.parent_relationship.parent.title | escape }}"
                        {% endif %}
                      >
                        {{- item.product.title -}}
                      </a>

                      {%- liquid
                        assign cart_disclosure_unique_id = 'page-' | append: item.index

                        if context == 'drawer'
                          assign cart_disclosure_unique_id = 'drawer-' | append: item.index
                        endif
                      -%}

                      {% render 'cart-disclosure-tooltip',
                        product: item.product,
                        unique_id: cart_disclosure_unique_id,
                        mode: 'trigger'
                      %}
                    </div>

                    <!-- Variant -->

                    {% if item.item_components.size == 0 %}
                      {% assign variant_tag = blank %}

                      {% for tag in item.product.tags %}
                        {% assign tag_downcase = tag | downcase %}

                        {% if tag_downcase contains 'variant:' %}
                          {% assign variant_tag = tag | remove_first: 'Variant:' | strip %}
                          {% break %}
                        {% endif %}
                      {% endfor %}

                      {% if variant_tag != blank %}
                        <dl class="cart-items__variants">
                          <div class="cart-items__variant">
                            <dt class="visually-hidden">Variant:</dt>
                            <dd class="cart-variant-tag">
                              {{ variant_tag }}
                            </dd>
                          </div>
                        </dl>
                      {% endif %}
                    {% endif %}

                  </div>
                    <!--
                      ==================================
                           METAFIELD DESCRIPTION
                      ===================================
                    -->

                    {% assign product_description = item.product.metafields.custom.description.value %}

                    {% if product_description != blank %}
                      <div class="cart-items__metafield-description">
                        {{ product_description }}
                      </div>
                    {% endif %}

                    <!-- Bundle components -->

                    {%- if item.item_components.size != 0 -%}
                      <ul class="cart-items__bundle list-unstyled">
                        {%- for component in item.item_components -%}
                          <li>
                            {{- component.title -}}

                            {%- if component.quantity > 1 -%}
                              <span> × {{ component.quantity }} </span>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}

                    <!-- Selling plan -->

                    {%- if item.selling_plan_allocation -%}
                      <p class="cart-items__selling-plan">
                        {{ item.selling_plan_allocation.selling_plan.name }}
                      </p>
                    {%- endif -%}

                    <!--
                      ==================================
                           PRICE UNDER DESCRIPTION
                      ===================================
                    -->

                    <div class="cart-items__product-price">
                      {% if item.original_price != item.final_price %}
                        <span class="visually-hidden">
                          {{ 'content.price_sale' | t }}
                        </span>

                        <span class="cart-items__sale-price">
                          {{ item.final_price | money }}
                        </span>

                        <s class="compare-at-price">
                          {% if item.variant.compare_at_price > item.original_price %}
                            {{ item.variant.compare_at_price | money }}
                          {% else %}
                            {{ item.original_price | money }}
                          {% endif %}
                        </s>

                      {% else %}
                        <span>
                          {{ item.original_price | money }}
                        </span>

                        {% if item.variant.compare_at_price > item.original_price %}
                          <s class="compare-at-price">
                            {{ item.variant.compare_at_price | money }}
                          </s>
                        {% endif %}
                      {% endif %}
                    </div>
                  </div>

                  <!-- Cart properties -->

                  {%- liquid
                    assign has_visible_properties = false

                    for property in item.properties
                      assign property_first_char = property.first | slice: 0

                      if property.last != blank and property_first_char != '_'
                        assign has_visible_properties = true
                        break
                      endif
                    endfor
                  -%}

                  {% if has_visible_properties %}
                    <dl class="cart-items__properties">
                      {% for property in item.properties %}
                        {% assign property_first_char = property.first | slice: 0 %}

                        {% if property.last != blank and property_first_char != '_' %}
                          <div class="cart-items__property">
                            <dt>{{ property.first }}:</dt>

                            <dd>
                              {% if property.last contains '/uploads/' %}
                                <a href="{{ property.last }}">
                                  {{ property.last | split: '/' | last }}
                                </a>

                              {% else %}
                                {{ property.last }}
                              {% endif %}
                            </dd>
                          </div>
                        {% endif %}
                      {% endfor %}
                    </dl>
                  {% endif %}
                </td>

                <!--
                  ==================================
                       COLUMN 4:
                       UNIT PRICE + QUANTITY
                  ===================================
                -->

                <td
                  class="cart-items__quantity-column"
                  role="cell"
                >
                  <div class="cart-items__price-quantity">
                    

                    <!-- Quantity -->

                    {% assign can_update_quantity = item.instructions.can_update_quantity
                      | default: true, allow_false: true
                    %}

                    <div class="cart-items__quantity-controls">
                      {% render 'volume-pricing-info',
                        variant: item.variant,
                        unique_id: item.index,
                        quantity: item.quantity
                      %}

                      {% render 'quantity-selector',
                        product: item.product,
                        variant: item.variant,
                        in_cart_quantity: item.quantity,
                        line_index: item.index,
                        class: 'cart-primary-typography',
                        can_update_quantity: can_update_quantity
                      %}
                    </div>
                  </div>
                </td>

                <!--
                  ==================================
                       COLUMN 5:
                       FINAL TOTAL
                  ===================================
                -->

                {%- liquid
                  if settings.currency_code_enabled_cart_items
                    assign price = item.final_line_price | money_with_currency
                    assign unit_price = item.unit_price | money_with_currency

                  else
                    assign price = item.final_line_price | money
                    assign unit_price = item.unit_price | money
                  endif
                -%}

                {% comment %} <td
                  class="cart-items__price cart-items__final-price"
                  role="cell"
                >
                  <text-component
                    value="{{ price | strip_html }}"
                  >
                    {{ price }}
                  </text-component>

                  {% if item.unit_price_measurement %}
                    <div class="cart-items__price-unit">
                      {% render 'unit-price', price: unit_price, measurement: item.unit_price_measurement %}
                    </div>
                  {% endif %}
                </td> {% endcomment %}

                <td 
  class="cart-items__price cart-items__final-price" 
  role="cell"
>
 {% assign display_price = price | split: ' ' | first %}

  <text-component 
    value="{{ display_price | strip_html }}"
  >
    {{ display_price }}
  </text-component>

  {% if item.unit_price_measurement %}
    <div class="cart-items__price-unit">
      {% render 'unit-price',
        price: unit_price,
        measurement: item.unit_price_measurement
      %}
    </div>
  {% endif %}
</td>

                <!-- Error -->

                <td
                  class="cart-items__error hidden"
                  role="cell"
                  ref="cartItemErrorContainer-{{ item.index | plus: 1 }}"
                >
                  <div
                    class="cart-item__error"
                    role="alert"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>

                    <small
                      class="cart-item__error-text cart-primary-typography"
                      ref="cartItemError-{{ item.index | plus: 1 }}"
                    ></small>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <!-- Disclosure dialogs -->

        {% for item in cart.items %}
          {%- liquid
            assign cart_disclosure_unique_id = 'page-' | append: item.index

            if context == 'drawer'
              assign cart_disclosure_unique_id = 'drawer-' | append: item.index
            endif
          -%}

          {% render 'cart-disclosure-tooltip',
            product: item.product,
            unique_id: cart_disclosure_unique_id,
            mode: 'dialog'
          %}
        {% endfor %}
      </div>
    </form>
  {%- endif -%}
</div>

{% stylesheet %}
  /* =========================================================
     CART WRAPPER
  ========================================================= */

  .cart-items {
    --cart-item-media-width-min: 2.5rem;
    --cart-item-media-width-max: 7.5rem;

    container-name: cart-items;
    container-type: inline-size;

    width: 100%;
  }

  .cart-items-disabled {
    pointer-events: none;
  }

  .cart-items__wrapper {
    display: flex;
    flex-direction: column;
  }


  /* =========================================================
     TABLE
  ========================================================= */

  .cart-items__table {
    width: 100%;
    border-spacing: 0;
    border-collapse: collapse;
  }

  .cart-items__table * {
    margin: 0;
  }


  /* =========================================================
     TABLE HEADER
  ========================================================= */

  .cart-items__table-head {
    display: none;
  }

  .cart-items__table-header-row {
    display: grid;

    grid-template-columns:
      50px
      110px
      minmax(250px, 1fr)
      180px
      150px;

    column-gap: var(--gap-md);

    align-items: center;

    padding-bottom: var(--padding-md);

    border-bottom: 1px solid
      rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .cart-items__header {
    font-size: var(--font-size--sm);
    font-weight: var(--font-weight-bold);

    color: var(--color-foreground);

    text-align: left;
  }

  .cart-items__header--total {
    text-align: right;
  }


  /* =========================================================
     PRODUCT ROW
  ========================================================= */

  .cart-items__table-row {
    display: grid;

    grid-template-columns: auto 80px minmax(220px, 1fr) 100px 50px;

    column-gap: var(--gap-md);

    align-items: center;

    padding-block: var(--padding-lg);

    border-bottom: 1px solid
      rgb(var(--color-foreground-rgb) / var(--opacity-10-25));

    position: relative;
  }


  /* =========================================================
     DELETE / BIN COLUMN
  ========================================================= */

  .cart-items__remove-column {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 100%;
  }

  .cart-items__remove {
    background: transparent;

    color: var(--color-foreground);

    width: var(--minimum-touch-target);
    height: var(--minimum-touch-target);

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 0;

    box-shadow: none;

    border: 0;

    cursor: pointer;
  }

  .cart-items__remove svg {
    width: 20px;
    height: 20px;
  }

  .cart-items__remove:hover {
    color: var(--color-foreground);
  }


  /* =========================================================
     IMAGE COLUMN
  ========================================================= */

  .cart-items__media {
    padding: 0;

    width: 100%;
  }

  .cart-items__media-container {
    display: flex;

    aspect-ratio: var(--ratio);

    position: relative;

    width: 100%;

    overflow: hidden;
  }

  .cart-items__media-image {
    aspect-ratio: inherit;

    object-fit: cover;

    object-position: center center;

    width: 100%;

    height: auto;

    display: block;
  }


  /* =========================================================
     PRODUCT INFORMATION
  ========================================================= */

  .cart-items__details {
    min-width: 0;

    color:
      rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .cart-items__product-info {
    min-width: 0;

    display: flex;

    flex-direction: column;

    gap: var(--gap-3xs);
  }


  /* Product title */

  .cart-items__heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
}

  .cart-items__title-row {
    display: flex;

    align-items: center;

    gap: var(--gap-xs);

    max-width: 100%;

    min-width: 0;
  }

  .cart-items__title {
    font-weight: 700;
      font-size: 15px;
      color: #1D1A17;
      text-decoration: none;
      font-family: 'Oswald';
  }


  /* Vendor */

  .cart-items__vendor {
    font-size: var(--font-size--sm);

    color:
      rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }


  /* =========================================================
     VARIANT
  ========================================================= */

  .cart-variant-tag {
    color: #14181A;
    background: linear-gradient(90deg, #EAF4FC 50%, #C7E0F4 100%, #8FB8DC 100%);
    border: 1px solid #D6EDFE;
    font-size: 11px;
    font-weight: 700;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
}

  .cart-items__variants {
    display: flex;

    flex-wrap: wrap;

    gap: 4px;

    padding: 0;

    margin-top: 3px;
  }

  .cart-items__variant {
    display: inline-flex;

    font-size: var(--font-size--sm);

    color:
      rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .cart-items__variant dt {
    display: none;
  }

  .cart-items__variant dd {
    display: inline;

    margin: 0;
  }


  /* =========================================================
     METAFIELD DESCRIPTION
  ========================================================= */

  .cart-items__metafield-description {
    font-size: var(--font-size--sm);

    line-height: 1.5;

    color:
      rgb(var(--color-foreground-rgb) / var(--opacity-70));

    margin-top: 4px;

    max-width: 600px;
  }


  /* =========================================================
     PRICE UNDER DESCRIPTION
  ========================================================= */

  .cart-items__product-price {
    display: flex;

    align-items: center;

    gap: 8px;

    margin-top: 7px;

    font-size: 13px;
      color: #6b6b6b;
  }

  .cart-items__sale-price {
    color: var(--color-foreground);
  }

  .compare-at-price {
    opacity: 0.6;
  }


  /* =========================================================
     BUNDLE
  ========================================================= */

  .cart-items__bundle {
    display: block;

    margin-top: 5px;
  }

  .cart-items__bundle li {
    font-size: var(--font-size--sm);
  }


  /* =========================================================
     PROPERTIES
  ========================================================= */

  .cart-items__properties {
    display: block;

    margin-top: var(--margin-2xs);
  }

  .cart-items__property {
    display: block;

    font-size: var(--font-size--sm);
  }

  .cart-items__properties dt,
  .cart-items__properties dd {
    display: inline;

    margin: 0;

    overflow-wrap: break-word;
  }


  /* =========================================================
     COLUMN 4
     PRICE + QUANTITY
  ========================================================= */

  .cart-items__quantity-column {
    width: 100%;
  }

  .cart-items__price-quantity {
    display: flex;

    flex-direction: column;

    align-items: flex-start;

    justify-content: center;

    gap: var(--gap-sm);
  }


  /* Unit price */

  .cart-items__unit-price {
    font-size: var(--font-size--sm);

    color: var(--color-foreground);

    font-weight: var(--font-weight-medium);
  }


  /* Quantity */

  .cart-items__quantity-controls {
    display: flex;

    align-items: center;

    justify-content: flex-start;

    gap: var(--gap-xs);

    width: 100%;
  }

  .cart-items__quantity-controls > .volume-pricing-info {
    margin-inline-start:
      calc(-1 * var(--minimum-touch-target) - var(--gap-xs));
  }

  .cart-items__quantity-controls .quantity-selector-wrapper {
    width: -webkit-fill-available;
  }

  .cart-items__quantity-controls .quantity-selector {
    display: inline-flex;

    font-size: var(--font-size--sm);

    height: auto;
  }


  /* =========================================================
     COLUMN 5
     FINAL PRICE
  ========================================================= */

  .cart-items__final-price {
    min-width: 0;

    text-align: right;

    display: flex;

    flex-direction: column;

    align-items: flex-end;

    justify-content: center;

    font-size: var(--font-size--md);

    font-weight: var(--font-weight-bold);

    color: #1769e0;
  }

  .cart-items__final-price text-component {
    color: #1769e0;
    font-weight: 700;
    font-size: 15px;
    color: #207fc4;
    padding: 0.3rem 0.6rem;
    min-width: 76px;
    text-align: center;
  }

  .cart-items__price-unit {
    font-size: var(--font-size--xs);

    padding-block-start: var(--padding-2xs);

    color:
      rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }


  /* =========================================================
     ERROR
  ========================================================= */

  .cart-items__error {
    grid-column: 3 / -1;

    display: flex;

    align-items: flex-start;

    width: 100%;

    margin-block-start: var(--margin-xs);

    opacity: 1;

    overflow: hidden;

    transform: translateY(0);

    transition:
      opacity var(--drawer-animation-speed) var(--animation-easing),
      transform var(--drawer-animation-speed) var(--animation-easing);
  }

  .cart-item__error {
    display: flex;

    align-items: flex-start;

    width: 100%;

    font-size: var(--font-size--sm);

    padding-block: var(--padding-2xs);
  }

  .cart-item__error .svg-wrapper {
    flex-shrink: 0;

    width: var(--icon-size-xs);

    height: var(--icon-size-xs);

    margin-inline:
      var(--margin-3xs) var(--margin-xs);

    margin-block-start: var(--margin-3xs);
  }


  /* =========================================================
     EMPTY CART
  ========================================================= */

  .cart-page--empty .cart-items__wrapper {
    align-items: center;

    margin-block-start: 0;

    text-align: center;
  }

  .cart-items__wrapper--drawer-empty {
    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;
  }

  .cart-items__empty-button {
    margin-top: var(--margin-md);

    margin-inline: auto;

    padding-inline: var(--padding-4xl);

    padding-block: var(--padding-lg);
  }


  /* =========================================================
     DIVIDERS
  ========================================================= */

  .cart-items--dividers .cart-items__table-row {
    border-bottom:
      1px solid
      rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }


  /* =========================================================
     REMOVE ANIMATION
  ========================================================= */

  .remove-icon-bottom,
  .remove-icon-top {
    transition:
      transform var(--animation-speed) var(--animation-easing);
  }

  .cart-items__remove:hover .remove-icon-top {
    transform:
      translate(
        calc(-1 * var(--icon-stroke-width)),
        var(--icon-stroke-width)
      )
      rotate(-15deg);
  }

  .cart-items__remove:is(:hover, :active) .remove-icon-bottom {
    transform:
      translateY(var(--icon-stroke-width));
  }

  .cart-items__table-row.removing .remove-icon-bottom {
    transform: translateY(0);
  }

  .cart-items__table-row.removing .remove-icon-top {
    animation:
      removeButtonClickedIconTop
      var(--animation-speed)
      var(--animation-easing)
      forwards;
  }

  @keyframes removeButtonClickedIconTop {

    50% {
      transform:
        translate(
          0,
          calc(-1 * var(--icon-stroke-width))
        );
    }

    100% {
      transform:
        translate(0, 0);
    }

  }


  /* =========================================================
     REMOVE ROW ANIMATION
  ========================================================= */

  .cart-items__table-row.removing {
    overflow: hidden;

    animation:
      removeRow
      calc(var(--animation-speed) * 2)
      var(--animation-easing)
      forwards;

    animation-delay: var(--animation-speed);
  }

  @keyframes removeRow {

    0% {
      height: var(--row-height);
    }

    100% {
      opacity: 0;

      height: 0;

      padding-bottom: 0;

      margin-bottom: 0;

      border-color: transparent;
    }

  }


  /* =========================================================
     ADD ROW ANIMATION
  ========================================================= */

  .cart-items__table-row.adding {
    interpolate-size: allow-keywords;

    overflow: hidden;

    animation:
      addRow
      calc(var(--animation-speed) * 2)
      var(--animation-easing)
      forwards;
  }

  @keyframes addRow {

    0% {
      opacity: 0;

      height: 0;

      padding-bottom: 0;

      margin-bottom: 0;

      border-color: transparent;
    }

    100% {
      opacity: 1;

      height: auto;
    }

  }


  /* =========================================================
     MOBILE
  ========================================================= */

  @media screen and (max-width: 749px) {

    .cart-items__table-header-row {
      display: none;
    }

    .cart-items__table-row {
      grid-template-columns:
        36px
        80px
        minmax(0, 1fr);

      grid-template-areas:
        'remove media details'
        'remove media quantity'
        'remove media total';

      column-gap: var(--gap-sm);

      align-items: start;

      padding-block: var(--padding-md);
    }


    /* Delete */

    .cart-items__remove-column {
      grid-area: remove;

      padding-top: 4px;
    }


    /* Image */

    .cart-items__media {
      grid-area: media;
    }


    /* Details */

    .cart-items__details {
      grid-area: details;
    }


    /* Price + quantity */

    .cart-items__quantity-column {
      grid-area: quantity;

      margin-top: var(--margin-xs);
    }

    .cart-items__price-quantity {
      flex-direction: row;

      align-items: center;

      justify-content: flex-start;

      gap: var(--gap-sm);
    }


    /* Final price */

    .cart-items__final-price {
      grid-area: total;

      margin-top: var(--margin-xs);

      align-items: flex-start;

      text-align: left;
    }


    /* Error */

    .cart-items__error {
      grid-column: 1 / -1;

      grid-area: auto;
    }


    .cart-items__title {
      font-size: var(--font-size--sm);
    }

    .cart-items__metafield-description {
      font-size: var(--font-size--xs);
    }

  }


  /* =========================================================
     DESKTOP QUANTITY SELECTOR
  ========================================================= */

  @media screen and (min-width: 750px) {

    .cart-items .quantity-selector {
      --quantity-selector-width: 105px;

      height: var(--button-size-md);

      width: var(--quantity-selector-width);
    }

    .cart-items .quantity-selector button {
      width: var(--button-size-md);

      height: var(--button-size-md);
    }

    .cart-items .quantity-selector input {
      max-width:
        calc(
          var(--quantity-selector-width)
          - var(--button-size-md) * 2
        );
    }

  }


  /* =========================================================
     RESPONSIVE TABLE
  ========================================================= */

  @container cart-items (min-width: 720px) {

    .cart-items__table-row {
      grid-template-columns:
        50px
        110px
        minmax(250px, 1fr)
        180px
        70px;
    }

  }


  /* =========================================================
     CART SUMMARY
  ========================================================= */

  .cart__subtotal-container,
  .cart__total-container {
    display: flex;

    flex-direction: column;
  }

  .cart__total-container {
    row-gap: var(--gap-2xs);
  }

  .cart__subtotal-container:empty {
    display: none;
  }

  .cart__summary-totals {
    display: flex;

    flex-direction: column;

    gap: var(--gap-xl);

    width: 100%;

    border-block-start: none;
  }

  .cart__subtotal-container,
  .cart__subtotal-container * {
    font-size: var(--font-size--sm);
  }

  .cart__total {
    font-weight: var(--font-weight-bold);
  }

  .cart__total-label {
    font-size: var(--font-size--sm);
  }

  .cart__total-value {
    font-size: var(--font-size--xl);
  }

  .cart__ctas {
    width: 100%;

    display: grid;

    gap: var(--checkout-button-gap);

    grid-auto-flow: row;

    grid-template-columns: 1fr;
  }

  .cart__additional-checkout-buttons {
    width: 100%;
  }


  /* =========================================================
     SHOPIFY ACCELERATED CHECKOUT
  ========================================================= */

  shopify-accelerated-checkout-cart {
    --shopify-accelerated-checkout-inline-alignment: center;

    --shopify-accelerated-checkout-button-border-radius:
      var(--style-border-radius-buttons-primary);

    --shopify-accelerated-checkout-button-block-size:
      var(--height-buy-buttons);

    --shopify-accelerated-checkout-row-gap:
      var(--checkout-button-gap, 10px);
  }


  /* =========================================================
     REDUCED MOTION
  ========================================================= */

  @media screen and (prefers-reduced-motion: no-preference) {

    html:active-view-transition-type(empty-cart-drawer) {

      .cart-items__empty-button,
      .cart__checkout-button {

        view-transition-name:
          cart-drawer-primary-action;

        & > .button-text {
          view-transition-name:
            cart-drawer-primary-action-text;
        }

      }

    }

  }


  /* =========================================================
     VIEW TRANSITION
  ========================================================= */

  ::view-transition-old(cart-drawer-primary-action-text),
  ::view-transition-new(cart-drawer-primary-action-text) {

    height: 100%;

    object-fit: none;

    overflow: clip;

    overflow-clip-margin: 1em;

  }

  ::view-transition-old(cart-drawer-primary-action-text) {

    animation:
      cart-drawer-primary-action-text
      var(--animation-speed)
      var(--animation-easing)
      reverse
      forwards;

  }

  ::view-transition-new(cart-drawer-primary-action-text) {

    animation:
      cart-drawer-primary-action-text
      var(--animation-speed)
      var(--animation-easing)
      forwards;

  }

  ::view-transition-old(cart-drawer-primary-action),
  ::view-transition-new(cart-drawer-primary-action) {

    height: 100%;

  }

  ::view-transition-group(cart-drawer-primary-action-text),
  ::view-transition-group(cart-drawer-primary-action) {

    animation-duration:
      var(--spring-d300-b0-duration);

    animation-timing-function:
      var(--spring-d300-b0-easing);

  }

  @keyframes cart-drawer-primary-action-text {

    from {
      filter: blur(3px);
      opacity: 0;
    }

    to {
      filter: none;
      opacity: 1;
    }

  }
{% endstylesheet %}
