{% comment %}
  Plain snippet — no schema, no theme-editor settings, nothing to configure
  in the customizer. Save as snippets/cart-drawer-custom.liquid and render
  it once, e.g. right before </body> in theme.liquid:

    {% render 'cart-drawer-custom' %}

  HOOKING IT UP:
  - Any element with [data-cart-drawer-toggle] opens the drawer on click.
    Add that attribute to your existing cart/bag icon in the header, e.g:
      <a href="{{ routes.cart_url }}" data-cart-drawer-toggle>Cart ({{ cart.item_count }})</a>
    The click is intercepted (preventDefault) so it opens the drawer instead
    of navigating, but if JS fails for any reason the href still works as a
    graceful fallback to the real cart page.
  - Listens for `cart:updated` (dispatched by this file) if you want other
    parts of your theme (header cart count bubble, etc.) to react.

  REAL DATA USED:
  - cart.items — actual cart line items, rendered server-side on load
  - Quantity +/- and remove use Shopify's real /cart/change.js AJAX endpoint
  - Checkout button submits the real cart form to /checkout
  - "View cart" links to routes.cart_url (your cart page section)
  - "Estimate shipping" calls Shopify's real /cart/shipping_rates.json
  - "Buy it with" Add-to-cart buttons use the real /cart/add.js AJAX endpoint
  - Badges + subtitle: same metafields as your cart page
    (product.metafields.custom.variant / subtitle / release_date)

    # Products to show under "Buy it with" now come from a collection
  # instead of a hardcoded handle list. Set this to any collection handle
  # in your store (Admin → Products → Collections — the handle is the
  # part of the collection's URL after /collections/).
  assign gl_biw_collection_handle = 'cart-cross-sell'
  assign gl_biw_limit = 4

  CONFIG — edit these directly instead of theme-editor settings:
{%- endcomment -%}

{%- liquid
  assign gl_price_color = '#2F6FED'
  assign gl_subtotal_bg_color = '#a10a0a'
  assign gl_continue_shopping_url = routes.all_products_collection_url
  assign gl_low_stock_threshold = 5

  # Handles of the products to show under "Buy it with". Edit this list.
  assign gl_biw_collection_handle = 'all-products'
  assign gl_biw_limit = 4
-%}

<style>
  .gl-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    z-index: 998;
  }
  .gl-drawer-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .gl-cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: 480px;
    max-width: 92vw;
    background: #ffffff;
    box-shadow: -6px 0 24px rgba(0, 0, 0, 0.12);
    transform: translateX(100%);
    transition: transform 0.28s ease;
    z-index: 999;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .gl-cart-drawer.is-open {
    transform: translateX(0);
  }

  /* --- Two-panel slide: cart view <-> shipping view --- */
  .gl-drawer-panels {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .gl-drawer-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    transform: translateX(0);
    transition: transform 0.28s ease;
  }

  .gl-panel-cart {
    z-index: 2;
  }

  .gl-panel-shipping {
    z-index: 1;
    transform: translateX(100%);
  }

  .gl-cart-drawer.shipping-open .gl-panel-cart {
    transform: translateX(-100%);
  }
  .gl-cart-drawer.shipping-open .gl-panel-shipping {
    transform: translateX(0);
    z-index: 3;
  }

  /* --- Shared header --- */
  .gl-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid #C0DFF6;
    flex-shrink: 0;
  }
  .gl-drawer-header h2 {
    font-size: 20px;
    font-weight: 700;
    margin: 0;
    color: #1D1A17;
  }
  .gl-drawer-header__back {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    font-weight: 700;
    color: #1D1A17;
    padding: 0;
  }
  .gl-drawer-close,
  .gl-drawer-header__back svg {
    background: none;
    border: none;
    cursor: pointer;
    color: #1D1A17;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gl-drawer-close svg,
  .gl-drawer-header__back svg { width: 16px; height: 16px; }

  /* --- Cart items --- */
  .gl-drawer-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 0 1.25rem;
  }

  .gl-cart-empty {
    text-align: center;
    padding: 3rem 1.25rem;
  }
  .gl-cart-empty__icon { width: 48px; height: 48px; margin: 0 auto 1rem; color: #c9c9c9; }
  .gl-cart-empty__heading { font-size: 18px; font-weight: 800; margin: 0 0 0.4rem; color: #1D1A17; }
  .gl-cart-empty__text { font-size: 13px; color: #6b6b6b; margin: 0 0 1.25rem; }
  .gl-cart-empty__continue {
    display: inline-flex;
    background: #111;
    color: #fff;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: 4px;
  }

  .gl-cart-item {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 0.75rem;
    padding: 1rem 0;
    border-bottom: 1px solid #f0f0f0;
  }
  .gl-cart-item__image img {
    display: block;
    width: 100%;
    border-radius: 4px;
    border: 1px solid #eee;
  }

  .gl-cart-item__title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    margin-bottom: 0.2rem;
  }
  .gl-cart-item__title {
    font-weight: 700;
    font-size: 20px;
    font-family: 'Oswald';
    color: #1D1A17;
    text-decoration: none;
    line-height: 1.3;
  }
  .gl-cart-item__badge {
    flex-shrink: 0;
    font-size: 10px;
    font-weight: 700;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .gl-cart-item__badge--foil {
    color: #14181A;
    background: linear-gradient(90deg, #EAF4FC 50%, #C7E0F4 100%, #8FB8DC 100%);
    border: 1px solid #D6EDFE;
  }
  .gl-cart-item__badge--preorder { background: #FCE6D6; color: #C25A1E; }

  .gl-cart-item__subtitle {
    font-size: 12px;
    color: #6b6b6b;
    margin: 0 0 6px;
  }

  .gl-cart-item__bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
  }

  .gl-cart-item__qty {
    display: flex;
    align-items: center;
    border: 1px solid #C0DFF6;
    border-radius: 4px;
    height: 34px;
  }
  .gl-cart-item__qty button {
    width: 28px;
    height: 100%;
    border: none;
    background: none;
    font-size: 16px;
    cursor: pointer;
  }
  .gl-cart-item__qty input {
    width: 28px;
    border: none;
    text-align: center;
    font-size: 13px;
  }

  .gl-cart-item__remove {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gl-cart-item__remove svg { width: 15px; height: 17px; }
  .gl-cart-item__remove:hover { color: #b0231c; }

  .gl-cart-item__right-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .gl-cart-item__price {
    font-weight: 700;
    font-size: 14px;
    color: {{ gl_price_color }};
  }

  /* --- Buy it with --- */

  .gl-buy-it-with {
    padding: 1.1rem 0;
    border-bottom: 1px solid #C0DFF6;
  }
  .gl-buy-it-with__heading {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 0.85rem;
    color: #1D1A17;
  }
  .gl-buy-it-with__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .gl-biw-card {
    background: white;
    padding: 8px;
    border: 1px solid #c0dff6;
    border-radius: 8px;
}
  
  .gl-biw-card__image {
    display: block;
    position: relative;
    margin-bottom: 0.6rem;
  }
  .gl-biw-card__image img {
    width: 100%;
    {% comment %} aspect-ratio: 1 / 1; {% endcomment %}
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid #eee;
    display: block;
  }
  .gl-biw-card__title {
    font-size: 12.5px;
    font-weight: 700;
    color: #1D1A17;
    text-decoration: none;
    display: block;
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }
  .gl-biw-card__price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
  }
  .gl-biw-card__price {
    font-weight: 700;
    font-size: 13px;
    color: {{ gl_price_color }};
  }
  .gl-biw-card__stock {
    font-size: 10px;
    font-weight: 700;
    color: #C25A1E;
    background: #FCE6D6;
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
  }
  .gl-biw-card__select {
    width: 100%;
    height: 34px;
    border: 1px solid #d8d8d8;
    border-radius: 4px;
    font-size: 12px;
    padding: 0 0.5rem;
    margin-bottom: 0.5rem;
    background: #fff;
  }
  .gl-biw-card__btn-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .gl-biw-card__qty {
    display: flex;
    align-items: center;
    border: 1px solid #C0DFF6;
    border-radius: 4px;
    height: 34px;
    flex-shrink: 0;
  }
  .gl-biw-card__qty button {
    width: 26px;
    height: 100%;
    border: none;
    background: none;
    font-size: 14px;
    cursor: pointer;
  }
  .gl-biw-card__qty input {
    width: 22px;
    border: none;
    text-align: center;
    font-size: 12px;
  }
  .gl-biw-card__add {
    flex: 1;
    height: 34px;
    background: #111;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gl-biw-card__add svg { width: 15px; height: 15px; }
  .gl-biw-card__add:hover { background: #000; }
  .gl-biw-card__add.gl-preorder-btn {
    width: 100%;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .gl-biw-card__add.is-added { background: #1e7e34; }

  /* --- Summary / footer --- */
  .gl-drawer-summary {
    flex-shrink: 0;
    {% comment %} padding: 1.1rem 1.25rem 1.25rem; {% endcomment %}
  }

  .gl-summary-box {
    background: {{ gl_subtotal_bg_color }};
    color: #fff;
    border-radius: 6px 6px 0 0;
    padding: 1.1rem 1.25rem;
  }
  .gl-summary-box__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
    font-size: 20px;
    text-transform: uppercase;
    font-family: 'Oswald';
  }
  .gl-summary-box__ship-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 14px;
    text-decoration: underline;
    color: #fff;
    background: none;
    border: none;
    cursor: pointer;
    font-family: 'Oswald';
    padding: 0;
  }

  .gl-drawer-actions {
    display: flex;
    gap: 0.6rem;
    padding: 0.9rem;
    background: #a10a0a;
  }
  .gl-drawer-actions a,
  .gl-drawer-actions button {
    flex: 1;
    font-family: 'Oswald';
    height: 42px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    border: none;
  }
  .gl-drawer-actions__view-cart {
    {% comment %} background: #fff; {% endcomment %}
    color: #ffffff;
    border: 1px solid #ffffff !important;
  }
  .gl-drawer-actions__checkout {
    background: #111;
    color: #fff;
  }
  .gl-drawer-actions__checkout:hover { background: #000; }

  /* --- Shipping panel --- */
  .gl-shipping-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 1.1rem 1.25rem;
  }
  .gl-shipping-field { margin-bottom: 1rem; }
  .gl-shipping-field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 0.35rem;
    color: #1D1A17;
  }
  .gl-shipping-field select,
  .gl-shipping-field input {
    width: 100%;
    height: 42px;
    padding: 0 0.75rem;
    border: 1px solid #d8d8d8;
    border-radius: 4px;
    font-size: 14px;
    box-sizing: border-box;
    background: #fff;
  }
  .gl-shipping-estimate-btn {
    width: 100%;
    height: 46px;
    background: #111;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-weight: 700;
    font-size: 14px;
    font-family: 'Oswald';
    text-transform: uppercase;
    cursor: pointer;
    margin-top: 0.25rem;
  }
  .gl-shipping-estimate-btn:hover { background: #000; }
  .gl-shipping-estimate-btn.is-loading { opacity: 0.6; pointer-events: none; }

  .gl-shipping-results {
    display: none;
    margin-top: 1.1rem;
    padding: 0.9rem;
    border: 1px solid #C0DFF6;
    border-radius: 4px;
    background: #F4FAFF;
    font-size: 13px;
  }
  .gl-shipping-results.is-visible { display: block; }
  .gl-shipping-results ul { margin: 0.4rem 0 0; padding-left: 1.1rem; }
  .gl-shipping-results li { margin-bottom: 0.3rem; }
  .gl-shipping-results strong { color: {{ gl_price_color }}; }

  
    @media screen and (max-width: 480px) {
    .gl-cart-drawer {
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      width: 100%;
      max-width: 100%;
      height: -webkit-fill-available;
      max-height: 88vh;
      border-radius: 16px 16px 0 0;
      transform: translateY(100%);
      box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.16);
    }
    .gl-cart-drawer.is-open {
      transform: translateY(0);
    }
  }
</style>

<div class="gl-drawer-overlay" data-gl-drawer-overlay></div>

<div class="gl-cart-drawer" data-gl-drawer role="dialog" aria-modal="true" aria-labelledby="gl-cart-drawer-heading">
  <div class="gl-drawer-panels">

    {%- comment -%} ===== PANEL 1: CART ===== {%- endcomment -%}
    <div class="gl-drawer-panel gl-panel-cart">
      <div class="gl-drawer-header">
        <h2 id="gl-cart-drawer-heading">Your cart ({{ cart.item_count }})</h2>
        <button type="button" class="gl-drawer-close" data-gl-drawer-close aria-label="Close cart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div class="gl-drawer-scroll">
        {%- if cart.item_count == 0 -%}
          <div class="gl-cart-empty">
            <svg class="gl-cart-empty__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            <p class="gl-cart-empty__heading">Your cart is empty</p>
            <p class="gl-cart-empty__text">Looks like you haven't added anything yet.</p>
            <a href="{{ gl_continue_shopping_url }}" class="gl-cart-empty__continue">
              Continue shopping
            </a>
          </div>
        {%- else -%}
          <div data-gl-cart-items>
            {%- for item in cart.items -%}
              <div class="gl-cart-item" data-gl-cart-item data-key="{{ item.key }}">
                <a href="{{ item.url }}" class="gl-cart-item__image">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.product.title | escape }}">
                  {%- endif -%}
                </a>

                <div class="gl-cart-item__details">
                  <div class="gl-cart-item__title-row">
                    <a href="{{ item.url }}" class="gl-cart-item__title">{{ item.product.title }}</a>
                    {%- if item.product.metafields.custom.variant != blank -%}
                      <span class="gl-cart-item__badge gl-cart-item__badge--foil">{{- item.product.metafields.custom.variant -}}</span>
                    {%- endif -%}
                    {%- if item.product.tags contains 'Pre-order' -%}
                      <span class="gl-cart-item__badge gl-cart-item__badge--preorder">Pre-order</span>
                    {%- endif -%}
                  </div>

                  {%- if item.product.metafields.custom.subtitle != blank -%}
                    <p class="gl-cart-item__subtitle">{{ item.product.metafields.custom.subtitle }}</p>
                  {%- endif -%}
                  {%- if item.product.tags contains 'Pre-order' and item.product.metafields.custom.release_date != blank -%}
                    <p class="gl-cart-item__subtitle">Release Date: {{ item.product.metafields.custom.release_date }}</p>
                  {%- endif -%}

                  <div class="gl-cart-item__bottom-row">
                    <div class="gl-cart-item__qty">
                      <button type="button" data-qty-minus aria-label="Decrease quantity">&minus;</button>
                      <input type="number" value="{{ item.quantity }}" min="1" data-qty-input>
                      <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
                    </div>
                    <div class="gl-cart-item__right-actions">
                      <button type="button" class="gl-cart-item__remove" data-remove-item aria-label="Remove {{ item.product.title }}">
                        <svg width="15" height="17" viewBox="0 0 15 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M9.09961 0.5V1.7002H13.9004V2.5H12.7002V14.9893C12.7002 15.3662 12.5749 15.666 12.3193 15.9199C12.0602 16.1772 11.7627 16.2997 11.4004 16.2998H3C2.63866 16.2998 2.34151 16.1774 2.08203 15.918C1.82255 15.6585 1.7002 15.3613 1.7002 15V2.5H0.5V1.7002H5.2998V0.5H9.09961ZM2.5 15.5H11.9004V2.5H2.5V15.5ZM9.09961 5.2998V12.7002H8.2998V5.2998H9.09961ZM6.09961 5.2998V12.7002H5.2998V5.2998H6.09961Z" fill="currentColor"/>
                        </svg>
                      </button>
                      <div class="gl-cart-item__price" data-line-price>{{ item.original_line_price | money }}</div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>

                    {%- assign gl_biw_collection = collections[gl_biw_collection_handle] -%}
          {%- if gl_biw_collection != blank and gl_biw_collection.products.size > 0 -%}
            <div class="gl-buy-it-with">
              <h3 class="gl-buy-it-with__heading">Buy it with</h3>
              <div class="gl-buy-it-with__grid">
                {%- for biw_product in gl_biw_collection.products limit: gl_biw_limit -%}
                  {%- assign biw_variant = biw_product.selected_or_first_available_variant -%}
                    <div class="gl-biw-card">
                      <a href="{{ biw_product.url }}" class="gl-biw-card__image">
                        {%- if biw_product.featured_image -%}
                          <img src="{{ biw_product.featured_image | image_url: width: 300 }}" alt="{{ biw_product.title | escape }}" loading="lazy">
                        {%- endif -%}
                      </a>
                      <a href="{{ biw_product.url }}" class="gl-biw-card__title">{{ biw_product.title }}</a>
                      <div class="gl-biw-card__price-row">
                        <span class="gl-biw-card__price">{{ biw_variant.price | money }}</span>
                          <span class="gl-biw-card__stock">{{ biw_variant.inventory_quantity }} left</span>
                      </div>

                      {%- if biw_product.metafields.custom.location_options != blank -%}
                        <select class="gl-biw-card__select" data-biw-location>
                          {%- for loc in biw_product.metafields.custom.location_options.value -%}
                            <option>{{ loc }}</option>
                          {%- endfor -%}
                        </select>
                      {%- endif -%}

                      {%- if biw_product.tags contains 'Pre-order' -%}
                        <button
                          type="button"
                          class="gl-biw-card__add gl-preorder-btn"
                          data-biw-add
                          data-variant-id="{{ biw_variant.id }}"
                        >
                          Pre-order
                        </button>
                      {%- else -%}
                        <div class="gl-biw-card__btn-row">
                          <div class="gl-biw-card__qty">
                            <button type="button" data-biw-qty-minus aria-label="Decrease quantity">&minus;</button>
                            <input type="number" value="1" min="1" data-biw-qty-input>
                            <button type="button" data-biw-qty-plus aria-label="Increase quantity">+</button>
                          </div>
                          <button
                            type="button"
                            class="gl-biw-card__add"
                            data-biw-add
                            data-variant-id="{{ biw_variant.id }}"
                            aria-label="Add {{ biw_product.title | escape }} to cart"
                          >
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                            </svg>
                          </button>
                        </div>
                      {%- endif -%}
                    </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if cart.item_count > 0 -%}
        <div class="gl-drawer-summary">
          <div class="gl-summary-box">
            <div class="gl-summary-box__row">
              <span>Subtotal</span>
              <span data-gl-subtotal>{{ cart.total_price | money }}</span>
            </div>
            <button type="button" class="gl-summary-box__ship-link" data-gl-open-shipping>Estimate shipping</button>
          </div>
          <div class="gl-drawer-actions">
            <a href="{{ routes.cart_url }}" class="gl-drawer-actions__view-cart">View cart</a>
            <form action="{{ routes.cart_url }}" method="post" style="flex:1; display:flex;">
              <button type="submit" name="checkout" class="gl-drawer-actions__checkout" style="width:100%;">Checkout</button>
            </form>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ===== PANEL 2: SHIPPING ===== {%- endcomment -%}
    <div class="gl-drawer-panel gl-panel-shipping">
      <div class="gl-drawer-header">
        <button type="button" class="gl-drawer-header__back" data-gl-close-shipping aria-label="Back to cart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>Estimate shipping</span>
        </button>
      </div>

      <div class="gl-shipping-scroll">
        <div class="gl-shipping-field">
          <label for="gl-shipping-country-drawer">Country</label>
          <select id="gl-shipping-country-drawer" data-gl-shipping-country>
            {{ all_country_option_tags }}
          </select>
        </div>

        <div class="gl-shipping-field">
          <label for="gl-shipping-province-drawer">State</label>
          <select id="gl-shipping-province-drawer" data-gl-shipping-province></select>
        </div>

        <div class="gl-shipping-field">
          <label for="gl-shipping-zip-drawer">Zip code</label>
          <input type="text" id="gl-shipping-zip-drawer" data-gl-shipping-zip placeholder="e.g. 2000">
        </div>

        <button type="button" class="gl-shipping-estimate-btn" data-gl-estimate-shipping>Estimate shipping</button>

        <div class="gl-shipping-results" data-gl-shipping-results></div>
      </div>
    </div>

  </div>
</div>

<script>
  (function () {
    var drawer = document.querySelector('[data-gl-drawer]');
    var overlay = document.querySelector('[data-gl-drawer-overlay]');
    if (!drawer || !overlay) return;

    /* ---------- open / close ---------- */
    function openDrawer() {
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');
      document.documentElement.style.overflow = 'hidden';
    }
    function closeDrawer() {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      drawer.classList.remove('shipping-open');
      document.documentElement.style.overflow = '';
    }

    /* Event delegation, not a direct listener on the button itself —
       this way it still works even if the header/button gets re-rendered
       or hydrated by the theme's JS after this script first runs. */
    document.addEventListener('click', function (e) {
      var toggle = e.target.closest('[data-cart-drawer-toggle]');
      if (toggle) {
        e.preventDefault();
        openDrawer();
      }
    });
    drawer.querySelectorAll('[data-gl-drawer-close]').forEach(function (btn) {
      btn.addEventListener('click', closeDrawer);
    });
    overlay.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeDrawer();
    });

    /* ---------- shipping panel slide ---------- */
    var openShippingBtn = drawer.querySelector('[data-gl-open-shipping]');
    var closeShippingBtn = drawer.querySelector('[data-gl-close-shipping]');
    if (openShippingBtn) {
      openShippingBtn.addEventListener('click', function () {
        drawer.classList.add('shipping-open');
      });
    }
    if (closeShippingBtn) {
      closeShippingBtn.addEventListener('click', function () {
        drawer.classList.remove('shipping-open');
      });
    }

    /* ---------- cart line items: qty / remove (real /cart/change.js) ---------- */
    function updateLineItem(key, quantity) {
      return fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: key, quantity: quantity }),
      }).then(function (res) { return res.json(); });
    }

    function refreshSubtotal(cart) {
      var el = drawer.querySelector('[data-gl-subtotal]');
      if (el && window.Shopify && Shopify.formatMoney) {
        el.textContent = Shopify.formatMoney(cart.total_price, '{{ shop.money_format }}');
      }
    }

    function bindCartItemRow(row) {
      var key = row.dataset.key;
      var qtyInput = row.querySelector('[data-qty-input]');
      var minusBtn = row.querySelector('[data-qty-minus]');
      var plusBtn = row.querySelector('[data-qty-plus]');
      var removeBtn = row.querySelector('[data-remove-item]');
      var linePriceEl = row.querySelector('[data-line-price]');

      function applyQuantity(newQty) {
        if (newQty < 1) newQty = 1;
        qtyInput.value = newQty;
        updateLineItem(key, newQty).then(function (cart) {
          refreshSubtotal(cart);
          var updated = cart.items.find(function (i) { return i.key === key; });
          if (updated && linePriceEl && window.Shopify && Shopify.formatMoney) {
            linePriceEl.textContent = Shopify.formatMoney(updated.original_line_price, '{{ shop.money_format }}');
          }
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { itemCount: cart.item_count } }));
        });
      }

      if (minusBtn) minusBtn.addEventListener('click', function () { applyQuantity(parseInt(qtyInput.value, 10) - 1); });
      if (plusBtn) plusBtn.addEventListener('click', function () { applyQuantity(parseInt(qtyInput.value, 10) + 1); });
      if (qtyInput) qtyInput.addEventListener('change', function () { applyQuantity(parseInt(qtyInput.value, 10)); });
      if (removeBtn) {
        removeBtn.addEventListener('click', function () {
          updateLineItem(key, 0).then(function (cart) {
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: { itemCount: cart.item_count } }));
            window.location.reload();
          });
        });
      }
    }

    drawer.querySelectorAll('[data-gl-cart-item]').forEach(bindCartItemRow);

    /* ---------- Buy it with: qty + real /cart/add.js ---------- */
    drawer.querySelectorAll('.gl-biw-card').forEach(function (card) {
      var qtyInput = card.querySelector('[data-biw-qty-input]');
      var minusBtn = card.querySelector('[data-biw-qty-minus]');
      var plusBtn = card.querySelector('[data-biw-qty-plus]');
      var addBtn = card.querySelector('[data-biw-add]');

      if (minusBtn) {
        minusBtn.addEventListener('click', function () {
          var v = Math.max(1, parseInt(qtyInput.value, 10) - 1);
          qtyInput.value = v;
        });
      }
      if (plusBtn) {
        plusBtn.addEventListener('click', function () {
          var v = parseInt(qtyInput.value, 10) + 1;
          qtyInput.value = v;
        });
      }

      if (addBtn) {
        addBtn.addEventListener('click', function () {
          var variantId = addBtn.getAttribute('data-variant-id');
          var quantity = qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;

          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: variantId, quantity: quantity }),
          })
            .then(function (res) { return res.json(); })
            .then(function () {
              addBtn.classList.add('is-added');
              setTimeout(function () { addBtn.classList.remove('is-added'); }, 1200);
              return fetch('/cart.js').then(function (r) { return r.json(); });
            })
            .then(function (cart) {
              document.dispatchEvent(new CustomEvent('cart:updated', { detail: { itemCount: cart.item_count } }));
              window.location.reload();
            })
            .catch(function (err) {
              console.error('Add to cart failed:', err);
            });
        });
      }
    });

    /* ---------- shipping estimator (real /cart/shipping_rates.json) ---------- */
    var countrySelect = drawer.querySelector('[data-gl-shipping-country]');
    var provinceSelect = drawer.querySelector('[data-gl-shipping-province]');
    var zipInput = drawer.querySelector('[data-gl-shipping-zip]');
    var estimateBtn = drawer.querySelector('[data-gl-estimate-shipping]');
    var resultsBox = drawer.querySelector('[data-gl-shipping-results]');

    function populateProvinces() {
      if (!countrySelect || !provinceSelect) return;
      var selectedOption = countrySelect.options[countrySelect.selectedIndex];
      var provincesData = selectedOption ? selectedOption.getAttribute('data-provinces') : null;
      provinceSelect.innerHTML = '';
      if (!provincesData) return;
      try {
        var provinces = JSON.parse(provincesData);
        if (!provinces.length) {
          provinceSelect.innerHTML = '<option value="">N/A</option>';
          return;
        }
        provinces.forEach(function (p) {
          var opt = document.createElement('option');
          opt.value = p[0];
          opt.textContent = p[1];
          provinceSelect.appendChild(opt);
        });
      } catch (e) {
        console.error('Could not parse provinces:', e);
      }
    }

    if (countrySelect) {
      countrySelect.addEventListener('change', populateProvinces);
      populateProvinces();
    }

    if (estimateBtn) {
      estimateBtn.addEventListener('click', function () {
        var country = countrySelect ? countrySelect.value : '';
        var province = provinceSelect ? provinceSelect.value : '';
        var zip = zipInput ? zipInput.value.trim() : '';

        if (!zip) {
          resultsBox.innerHTML = '<strong>Please enter a zip/postal code.</strong>';
          resultsBox.classList.add('is-visible');
          return;
        }

        estimateBtn.classList.add('is-loading');
        resultsBox.classList.remove('is-visible');

        var params = new URLSearchParams({
          'shipping_address[zip]': zip,
          'shipping_address[country]': country,
          'shipping_address[province]': province,
        });

        fetch('/cart/shipping_rates.json?' + params.toString())
          .then(function (res) { return res.json(); })
          .then(function (data) {
            var rates = data.shipping_rates || [];
            if (!rates.length) {
              resultsBox.innerHTML = '<strong>No shipping rates available for this address.</strong>';
            } else {
              var html = '<strong>There are multiple shipping rates for your address:</strong><ul>';
              rates.forEach(function (rate) {
                html += '<li>' + rate.name + ': <strong>' + rate.presentment_currency + ' ' + rate.price + '</strong></li>';
              });
              html += '</ul>';
              resultsBox.innerHTML = html;
            }
            resultsBox.classList.add('is-visible');
          })
          .catch(function (err) {
            console.error('Shipping estimate failed:', err);
            resultsBox.innerHTML = '<strong>Could not estimate shipping. Please try again.</strong>';
            resultsBox.classList.add('is-visible');
          })
          .finally(function () {
            estimateBtn.classList.remove('is-loading');
          });
      });
    }
  })();
</script>
